# CommunityCar Frontend Environment Variables

# API Configuration
VITE_API_URL=https://localhost:5001/api
VITE_API_TIMEOUT=30000

# Application Configuration
VITE_APP_NAME=CommunityCar
VITE_APP_VERSION=1.0.0
VITE_APP_ENV=development

# Authentication
VITE_GOOGLE_CLIENT_ID=your-google-client-id
VITE_FACEBOOK_APP_ID=your-facebook-app-id

# File Upload
VITE_MAX_FILE_SIZE_MB=10
VITE_ALLOWED_FILE_TYPES=.jpg,.jpeg,.png,.gif

# Feature Flags
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_CHAT=true
VITE_ENABLE_AI_ASSISTANT=true

# Social Media Links
VITE_SOCIAL_FACEBOOK=https://www.facebook.com/profile.php?id=61583521502176
VITE_SOCIAL_INSTAGRAM=https://www.instagram.com/communitycarfree
VITE_SOCIAL_TWITTER=https://x.com/CommunityCarFe

# Analytics (Optional)
VITE_GA_TRACKING_ID=your-ga-tracking-id
VITE_HOTJAR_ID=your-hotjar-id

# Development
VITE_DEBUG=true
VITE_LOG_LEVEL=debug